/* 7. transactions */
{
    "transactionId": "TXN001", // Mã giao dịch (định dạng TXNxxx, duy nhất, dùng để tra cứu nhanh)
    "userId": "USR001", // Mã người dùng thực hiện giao dịch (liên kết với Users.userId)
    "borrowId": "BRW001", // Mã mượn sách liên quan giao dịch (nếu là thanh toán phí mượn trễ)
    "amount": 50000, // Số tiền giao dịch (đơn vị VNĐ, số nguyên)
    "type": "payment", // Loại giao dịch:
    //   - "payment" : Thanh toán phí mượn sách trễ
    //   - "deposit" : Nạp tiền vào tài khoản thư viện
    //   - "refund"  : Hoàn trả tiền cọc
    "method": "cash", // Phương thức thanh toán:
    //   - "cash" : Tiền mặt
    //   - "bank_transfer" : Chuyển khoản
    //   - "online_payment" : Thanh toán qua ví điện tử/thẻ
    "status": "completed", // Trạng thái giao dịch:
    //   - "completed" : Hoàn tất
    //   - "pending"   : Đang xử lý
    //   - "failed"    : Thất bại
    "transactionDate": {
        "$date": "2025-08-13T09:00:00Z"
    }, // Ngày giờ thực hiện giao dịch
    "note": "Thanh toán phí mượn sách trễ 3 ngày", // Ghi chú bổ sung về giao dịch
    "createdAt": {
        "$date": "2025-08-13T09:00:00Z"
    }, // Ngày giờ tạo bản ghi
    "updatedAt": {
        "$date": "2025-08-13T09:00:00Z"
    } // Ngày giờ cập nhật bản ghi
}

